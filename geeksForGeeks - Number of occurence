class Solution {
    static  int lowerBound(int[] arr,int  target){
        int n = arr.length;
        int s = 0;
        int e = n-1;
        int ans = n;
        int mid = s+(e-s)/2;
        while(s<=e){
            if(arr[mid] >= target){
                ans  =  mid;
                e= mid-1;
            }
            else if(arr[mid]<target){
               s = mid+1;
            }
            mid = s+(e-s)/2;
        }
        return ans;
    }
    static  int upperBound(int[] arr, int target){
        int n = arr.length;
        int s = 0;
        int e = n-1;
        int ans = n;
        int mid = s+(e-s)/2;
        while(s<=e){
            if(arr[mid] <= target){
                s = mid+1;
            }
            else if(arr[mid]>target){
                ans = mid;
                e = mid-1;
            }
            mid = s+(e-s)/2;
        }
        return ans;
    }
    int countFreq(int[] arr, int target) {
        int upperBound  = upperBound(arr, target);
        int lowerBound  = lowerBound(arr, target);
        int ans = upperBound - lowerBound;
        return ans;
    }
}
